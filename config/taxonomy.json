  "clustering": {
    "method": "hybrid",
    "stages": [
      {"name":"exact","rule":"canonical_url 相同或 guid 相同 → 同簇"},
      {"name":"entity","rule":"标题实体集合 Jaccard >= 0.5 且发布时间差 < 48h → 同簇"},
      {"name":"lexical","rule":"中文字符 bigram / 英文 token 的 TF-IDF 余弦 >= 0.62 → 同簇"},
      {"name":"ai_adjudicate","rule":"仅对 0.45 <= similarity < 0.62 的边界对调用模型判定同事件"}
    ],
    "similarity_threshold": 0.62,
    "ai_boundary_low": 0.45,
    "max_cluster_size": 8,
    "time_window_hours": 30,
    "cluster_title_source": "AI 生成，长度 <= 24 字，必须可由簇内至少 2 条标题佐证"
  },
  "quality_rules": {
    "require_source_url": true,
    "require_published_at": true,
    "max_summary_chars": 300,
    "max_why_matters_chars": 120,
    "forbid_ai_invented_url": true,
    "forbid_ai_invented_number": true,
    "missing_data_marker": "暂无可靠数据",
    "link_check_sample_ratio": 0.1,
    "min_sources_ok_ratio": 0.7
  }
